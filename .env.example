# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres: pooled (host has -pooler) for the app, direct for migrations
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# AI provider key (server-side only)
CEREBRAS_API_KEY=

# Google sign-in (console.cloud.google.com > OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Owner/admin Google account
ADMIN_EMAIL=
APP_URL=http://localhost:3000

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
